{
    "name": "zero-to-prod/laravel-jsonapi",
    "description": "JSON:API support for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "zero-to-prod/data-model-openapi30": "^0.2.0"
    },
    "require-dev": {
        "devizzent/cebe-php-openapi": "^1.1",
        "league/openapi-psr7-validator": "^0.24.0",
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "symfony/psr-http-message-bridge": "^8.1"
    },
    "suggest": {
        "devizzent/cebe-php-openapi": "Required by `php artisan jsonapi:validate` to validate the generated document."
    },
    "autoload": {
        "psr-4": {
            "ZeroToProd\\JsonApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZeroToProd\\JsonApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZeroToProd\\JsonApi\\JsonApiServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

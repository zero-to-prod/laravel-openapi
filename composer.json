{
    "name": "zero-to-prod/laravel-openapi",
    "description": "OpenAPI support for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "devizzent/cebe-php-openapi": "^1.1",
        "laravel/pint": "^1.30",
        "league/openapi-psr7-validator": "^0.24.0",
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.5",
        "symfony/psr-http-message-bridge": "^7.4|^8.1"
    },
    "suggest": {
        "devizzent/cebe-php-openapi": "Required by `php artisan openapi:validate` to validate the generated document.",
        "league/openapi-psr7-validator": "Required by the ValidatesSchema test trait to match responses against the document.",
        "nyholm/psr7": "PSR-7 implementation used by the ValidatesSchema test trait.",
        "symfony/psr-http-message-bridge": "Converts Laravel requests and responses to PSR-7 for the ValidatesSchema test trait."
    },
    "autoload": {
        "psr-4": {
            "ZeroToProd\\LaravelOpenapi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZeroToProd\\LaravelOpenapi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZeroToProd\\LaravelOpenapi\\LaravelOpenapiServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "rector": "rector process",
        "rector-lint": "rector process --dry-run",
        "check": [
            "@lint",
            "@rector-lint",
            "@analyse",
            "@test"
        ],
        "fix": [
            "@rector",
            "@format"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
